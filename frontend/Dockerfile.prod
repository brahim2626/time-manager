# ================================================
# DOCKERFILE FRONTEND — Production (Multi-stage)
# ================================================

# ── STAGE 1 : Build React ────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Construire l'application React en fichiers statiques
# Résultat : dossier /app/dist avec index.html, main.js, etc.
RUN npm run build

# ── STAGE 2 : Serveur Nginx ──────────────────────
# On sert les fichiers statiques avec Nginx
# (beaucoup plus rapide que Node.js pour ça)
FROM nginx:1.25-alpine

# Copier les fichiers buildés dans le dossier de Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Copier notre config Nginx de production
COPY ../nginx/nginx.prod.conf /etc/nginx/nginx.conf
COPY ../nginx/locations.conf  /etc/nginx/conf.d/locations.conf

EXPOSE 80

# Nginx se lance automatiquement
CMD ["nginx", "-g", "daemon off;"]